---
import Base from "../layouts/Base.astro";
import Typer from "../components/Typer.astro";
const title = "타자노트 — 치면서 배우는 한글 타자연습";
const desc = "설치 없이 브라우저에서 바로 하는 한글·영어 타자연습. 자리 연습부터 속담·사자성어·시 필사까지, 치면서 배우고 오타가 잦은 글쇠를 찾아 고칩니다.";
---
<Base title={title} desc={desc} path="/">
  <h1>오늘의 필사</h1>
  <p class="lead">날마다 한 편. 치는 동안 뜻과 작가를 알려 주니 손과 머리가 같이 남습니다.</p>

  <section id="today" class="today">
    <div class="tcard">
      <div class="tmascot" id="tmascot"></div>
      <div class="tmeta">
        <span class="tkind" id="tkind">시 한 편</span>
        <b id="ttitle">…</b>
        <span id="tby"></span>
        <span class="tinfo" id="tinfo"></span>
      </div>
    </div>
    <button type="button" class="go" id="tstart">오늘의 글 치기</button>
    <p class="hint" id="tstreak"></p>
  </section>

  <Typer />

  <h2>연습 고르기</h2>
  <div class="cards">
    <a class="card" href="/position"><i class="ico">⌨️</i><div><b>자리 연습</b><span>기본줄부터 쌍자음까지. 화면 자판이 다음 글쇠와 손가락을 알려 줍니다.</span></div><i>›</i></a>
    <a class="card" href="/words"><i class="ico">🫘</i><div><b>낱말 연습</b><span>짧은 낱말을 빠르게. 띄어쓰기로 바로 다음 낱말.</span></div><i>›</i></a>
    <a class="card" href="/short"><i class="ico">📖</i><div><b>짧은 글</b><span>속담·사자성어·생활 문장. 한 줄 칠 때마다 뜻이 뜹니다.</span></div><i>›</i></a>
    <a class="card" href="/long"><i class="ico">✍️</i><div><b>긴 글 필사</b><span>윤동주·김소월·이육사… 시 한 편을 끝까지 따라 씁니다.</span></div><i>›</i></a>
    <a class="card" href="/english"><i class="ico">🔤</i><div><b>영어</b><span>영어 낱말과 문장. 한/영 전환 없이 바로.</span></div><i>›</i></a>
    <a class="card" href="/record"><i class="ico">📈</i><div><b>내 기록</b><span>모드별 최고 기록, 주간 연습량, 오타가 잦은 글쇠 열지도.</span></div><i>›</i></a>
  </div>

  <article>
    <h2>타자노트는 무엇이 다른가요</h2>
    <p><b>치면서 배웁니다.</b> 속담 한 줄을 치고 나면 뜻이, 사자성어를 치면 한자와 풀이가, 시를 치면 작가와 발표 연도가 바로 뜹니다. 타자 연습 시간이 그대로 국어 공부 시간이 됩니다.</p>
    <p><b>약한 글쇠를 찾아 줍니다.</b> 틀린 글자를 자판 글쇠 단위로 세어 어느 글쇠가 자주 틀리는지, 어느 손가락이 약한지 알려 주고, 그 글쇠만 골라 자리 연습으로 이어집니다.</p>
    <p><b>설치도 가입도 없습니다.</b> 브라우저만 있으면 되고, 태블릿에 키보드를 붙여도 됩니다. 기록은 이 기기의 브라우저에만 저장되며 서버로 보내지 않습니다.</p>
    <p><b>글은 전부 떳떳한 것만.</b> 직접 쓴 생활 문장과, 저작권 보호 기간이 끝난 시(작가·연도 표시)만 씁니다.</p>

    <h2>타수는 이렇게 셉니다</h2>
    <p>한글 타자에서 <b>타수</b>는 글자 수가 아니라 <b>글쇠를 누른 횟수</b>입니다. "한"은 ㅎ·ㅏ·ㄴ 3타, "글"은 ㄱ·ㅡ·ㄹ 3타이고, 쌍자음(ㄲ·ㄸ·ㅃ·ㅆ·ㅉ)은 Shift와 함께 한 번에 누르므로 1타, 겹모음(ㅘ·ㅝ 등)과 겹받침(ㄳ·ㄺ 등)은 2타입니다. 띄어쓰기와 문장부호도 1타씩입니다. 타자노트의 <b>타/분</b>은 <b>맞게 친 글자의 타수</b>만 세어 1분 단위로 환산한 값입니다. 자세한 설명은 <a href="/guide/count-strokes">타수 세는 법</a>에 있습니다.</p>

    <h2>이렇게 연습해 보세요</h2>
    <ol>
      <li><b>자리 연습</b>에서 기본줄(ㅁㄴㅇㄹ ㅗㅓㅏㅣ)을 보지 않고 칠 수 있을 때까지.</li>
      <li><b>낱말 연습</b>으로 손가락이 글쇠를 기억하게 하고,</li>
      <li><b>짧은 글</b>로 띄어쓰기와 문장부호까지 익힌 뒤,</li>
      <li><b>긴 글 필사</b>로 지구력을 기릅니다. 결과 화면의 <b>오타가 잦았던 글쇠</b>가 뜨면 그 글쇠만 자리 연습으로 돌아가세요.</li>
    </ol>
    <p>더 자세한 방법은 <a href="/guide/how-to-type-fast">타자 빨라지는 법</a>과 <a href="/guide/finger-position">손가락 자리</a>에 정리했습니다.</p>
  </article>

  <style is:global>
    .today{margin:8px 0 8px}
    .tcard{display:flex;gap:16px;align-items:center;background:var(--accent-bg);border-radius:18px;padding:18px 20px;margin-bottom:12px}
    .tmascot svg{display:block;width:64px;height:64px}
    .tmeta{display:flex;flex-direction:column;gap:2px;min-width:0}
    .tkind{font-size:12px;font-weight:700;color:var(--accent);letter-spacing:.02em}
    .tmeta b{font-size:20px;letter-spacing:-.03em;line-height:1.3}
    .tmeta span{font-size:14px;color:var(--sub)}
    .tmeta .tinfo{font-size:13px;color:var(--mut)}
  </style>

  <script>
    import { todaysText, dayHash } from "../lib/daily.mjs";
    import { load, streak, todayStr } from "../lib/record.mjs";
    import { mascot } from "../lib/mascot.mjs";
    import { strokes } from "../lib/hangul.mjs";
    import texts from "../data/texts.json";
    import proverbs from "../data/proverbs.json";
    import idioms from "../data/idioms.json";
    import sentences from "../data/sentences.json";

    const $ = (id) => document.getElementById(id);
    const h = dayHash();
    // 날짜별로 시 한 편 ↔ 속담·사자성어·문장 섞음(5줄)을 번갈아 낸다
    let plan;
    if (h % 2 === 0) {
      const t = todaysText(texts);
      plan = { mode: "long", title: t.title, sub: `${t.author}${t.kind === "시" ? " · " + t.kind : ""}`, lines: t.lines, notes: t.lines.map((_, i) => i === t.lines.length - 1 ? `<b>${t.title}</b> · ${t.author}, ${t.year}. ${t.note}` : null) };
      $("tkind").textContent = t.kind === "시" ? "시 한 편" : "짧은 글";
      $("ttitle").textContent = t.title; $("tby").textContent = `${t.author} · ${t.year}`;
      $("tinfo").textContent = `${t.lines.length}줄 · ${strokes(t.lines.join(" "))}타`;
    } else {
      const pick = (arr, n, salt) => { const out = []; for (let i = 0; i < n; i++) out.push(arr[(h + salt * 7919 + i * 104729) % arr.length]); return out; };
      const p = pick(proverbs, 2, 1), s = pick(idioms, 2, 2), c = pick(sentences, 1, 3);
      const items = [...p.map((x) => ({ t: x.t, n: `<b>속담</b> · ${x.m}` })), ...s.map((x) => ({ t: x.t, n: `<b>사자성어</b> ${x.h} · ${x.m}` })), ...c.map((x) => ({ t: x, n: null }))];
      plan = { mode: "short", title: "오늘의 모음", sub: "속담 2 · 사자성어 2 · 문장 1", lines: items.map((x) => x.t), notes: items.map((x) => x.n) };
      $("tkind").textContent = "오늘의 모음";
      $("ttitle").textContent = "속담·사자성어·문장 5줄"; $("tby").textContent = todayStr().replaceAll("-", ". ");
      $("tinfo").textContent = `${strokes(plan.lines.join(" "))}타`;
    }
    $("tmascot").innerHTML = mascot("idle", 64);
    const rec = load(), st = streak(rec);
    $("tstreak").textContent = st ? `${st}일 연속 연습 중. 오늘도 한 편이면 ${st + 1}일이 됩니다.` : rec.runs.length ? "오늘 아직 연습 전이에요. 한 편만 쳐도 하루가 채워집니다." : "처음이시죠? 부담 없이 한 편만. 틀려도 지우고 다시 치면 됩니다.";
    const rival = Number((location.hash.match(/#t=(\d+)/) || [])[1]) || 0;
    if (rival) $("tstreak").textContent = `친구가 ${rival}타/분 기록을 보냈어요. 같은 오늘의 글로 겨뤄 보세요.`;
    $("tstart").addEventListener("click", () => {
      $("today").hidden = true;
      window.__typer.start({ ...plan, rival, onNew: () => { $("today").hidden = false; }, onQuit: () => { $("today").hidden = false; } });
    });
  </script>
</Base>
